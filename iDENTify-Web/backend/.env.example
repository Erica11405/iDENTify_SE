# Database
# Prefer DATABASE_URL in deployed environments.
# DATABASE_URL=mysql://user:password@host:25060/identify_app

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=identify_app
DB_TIMEZONE=+08:00

# Optional DB resolution overrides
# Set to 1 to force DB_* values even when DATABASE_URL is present
DB_FORCE_INDIVIDUAL=0
# Set to 1 to force an empty DB password (ignores DB_PASSWORD/DB_PASS)
DB_FORCE_EMPTY_PASSWORD=0

# Mailer (required for OTP + approval notifications)
MAILER_SERVICE=gmail
MAILER_USER=youremail@gmail.com
MAILER_PASS=your_app_password
MAILER_FROM=iDENTify Clinic <youremail@gmail.com>

# Optional SMTP host mode (if not using MAILER_SERVICE)
# MAILER_HOST=smtp.example.com
# MAILER_PORT=587
# MAILER_SECURE=false
